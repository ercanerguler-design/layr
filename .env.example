# ─── Runtime secrets ─────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://layr:layr_password@localhost:5432/layr_db?schema=public

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_very_long_random_secret_at_least_64_chars
JWT_REFRESH_SECRET=another_long_random_secret_for_refresh_tokens_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...buraya_openai_api_key_yaz

# ─── S3 / MinIO (object storage) ──────────────────────────────
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=layr-media
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_REGION=us-east-1

# ─── Web app ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ...buraya_mapbox_token_yaz
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
