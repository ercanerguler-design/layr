NODE_ENV=development
PORT=3001

# PostgreSQL database (local Docker or Neon)
DATABASE_URL=postgresql://layr:layr_password@localhost:5432/layr_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Generate different random values of at least 32 characters
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Optional AI and object storage integrations
OPENAI_API_KEY=
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=layr-media
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_REGION=us-east-1

# Web app
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
