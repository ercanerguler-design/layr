# API service environment. Set these values in the Vercel API project.
# Use a Neon pooled PostgreSQL connection string.
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Use different random values of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Include the production web aliases and any allowed preview domains.
CORS_ORIGINS=https://layr-sceinnovation.vercel.app,https://layr-azure.vercel.app

# Optional integrations.
REDIS_URL=redis://localhost:6379
OPENAI_API_KEY=
# Generated automatically when a Vercel Blob store is connected to layr-api.
BLOB_READ_WRITE_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_REGION=us-east-1
