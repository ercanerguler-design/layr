# Production env example for deployment (DO NOT commit secrets)
# Set these in your hosting provider (Vercel) secrets.

# Database (Neon) — Postgres connection string
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DATABASE>?schema=public

# JWT secrets
JWT_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me

# Next.js public API URL (point to deployed backend or same domain)
NEXT_PUBLIC_API_URL=https://your-api.example.com

# S3 / MinIO (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
# ==========================================================
# LAYR � PRODUCTION ENVIRONMENT
# Neon DB + AWS S3 + OpenAI + Vercel/Railway deployment
# ==========================================================

NODE_ENV=production
PORT=3001

# �� PostgreSQL (Neon DB) ���������������������������������
# https://neon.tech � Yeni proje � Connection string kopyala
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DATABASE>?sslmode=require

# �� Redis (Upstash - �cretsiz tier) ����������������������
# https://upstash.com � Redis � Connect � REST URL de�il, rediss:// URL
REDIS_URL=<REDIS_URL>

# �� JWT (�NEML�: bunlar� de�i�tir, g�vende tut) ����������
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<JWT_SECRET>
JWT_REFRESH_SECRET=<JWT_REFRESH_SECRET>
JWT_REFRESH_EXPIRES_IN=30d

# �� OpenAI ������������������������������������������������
# https://platform.openai.com/api-keys
OPENAI_API_KEY=<OPENAI_API_KEY>

# �� AWS S3 (Medya depolama) �������������������������������
# https://aws.amazon.com/s3/ � Bucket olu�tur � IAM user
AWS_ACCESS_KEY_ID=<AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<AWS_SECRET_ACCESS_KEY>
AWS_S3_BUCKET=<AWS_S3_BUCKET>
AWS_S3_ENDPOINT=<AWS_S3_ENDPOINT>
AWS_S3_REGION=<AWS_S3_REGION>

# �� Web App ������������������������������������������������
# Railway/Render/Vercel URL'inin
NEXT_PUBLIC_API_URL=https://api.layr.app
NEXT_PUBLIC_MAPBOX_TOKEN=<MAPBOX_TOKEN>
NEXT_PUBLIC_APP_URL=https://layr.app

# �� CORS ��������������������������������������������������
CORS_ORIGINS=https://layr.app,https://www.layr.app
