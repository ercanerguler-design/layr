# API service environment (not Vercel web project variables).
# This repository currently uses SQLite. Put the database on a persistent volume.
NODE_ENV=production
PORT=3001
DATABASE_URL=file:/data/layr.db

# Generate two different random secrets of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Include only the public app domains allowed to call the API.
CORS_ORIGINS=https://your-app.vercel.app

# Optional integrations.
REDIS_URL=redis://localhost:6379
OPENAI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_REGION=us-east-1
